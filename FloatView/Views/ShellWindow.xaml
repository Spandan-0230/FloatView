<Window x:Class="FloatView.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FloatView"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource FontUi}"
        Foreground="{StaticResource BrushText}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Border Margin="12"
            Background="{StaticResource BrushWindow}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}"
            Effect="{StaticResource ShadowCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Height="60"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Border Width="30"
                            Height="30"
                            CornerRadius="9"
                            Background="{StaticResource BrushAccent}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14"
                                              ShadowDepth="0"
                                              Opacity="0.35"
                                              Color="#FFFFFF" />
                        </Border.Effect>
                        <TextBlock Text="&#xE8B9;"
                                   FontFamily="{StaticResource FontIcon}"
                                   FontSize="14"
                                   Foreground="#0A0A0A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="FloatView"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="14.5"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Picture-in-Picture for Windows"
                                   FontSize="10"
                                   Foreground="{StaticResource BrushTextDim}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Style="{StaticResource IconButtonStyle}"
                        Tag="Danger"
                        AutomationProperties.Name="Quit FloatView"
                        ToolTip="Quit FloatView"
                        Click="Quit_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource FontIcon}" FontSize="11" />
                </Button>
            </Grid>

            <Border Grid.Row="0"
                    Height="1"
                    Background="{StaticResource BrushHairline}"
                    VerticalAlignment="Bottom" />

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="16,14,16,18">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,7">
                    <Ellipse Width="4" Height="4" Fill="{StaticResource BrushAccent}" VerticalAlignment="Center" />
                    <TextBlock Text="Target window"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="TargetButton"
                        Style="{StaticResource TargetSelectorStyle}"
                        AutomationProperties.Name="Choose window"
                        ToolTip="Choose the window to mirror"
                        Click="TargetButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="30"
                                Height="30"
                                CornerRadius="8"
                                Background="#14FFFFFF">
                            <Grid Width="18" Height="18">
                                <TextBlock Text="&#xE8B9;"
                                           FontFamily="{StaticResource FontIcon}"
                                           FontSize="13"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedWindow.Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Image Source="{Binding SelectedWindow.Icon}"
                                       Width="18"
                                       Height="18"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedWindow.Title, FallbackValue=Choose a window…, TargetNullValue=Choose a window…}"
                                       FontSize="12.5"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedWindow.Title}" />
                            <TextBlock Text="{Binding SelectedWindow.ProcessName}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,1,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="&#xE70D;"
                                   FontFamily="{StaticResource FontIcon}"
                                   FontSize="10"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Popup x:Name="TargetPopup"
                       PlacementTarget="{Binding ElementName=TargetButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       VerticalOffset="10"
                       Closed="TargetPopup_Closed">
                    <Grid Margin="16">
                        <Border Width="396"
                                Background="{StaticResource BrushSurface}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Effect="{StaticResource ShadowCard}"
                                Padding="10">
                            <StackPanel>
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource SearchBoxStyle}"
                                         AutomationProperties.Name="Search windows"
                                         TextChanged="SearchBox_TextChanged" />

                                <Grid Margin="0,9,0,0">
                                    <ListBox x:Name="WindowList"
                                             MaxHeight="258"
                                             Style="{StaticResource WindowListStyle}"
                                             AutomationProperties.Name="Open windows"
                                             ItemsSource="{Binding Windows}"
                                             SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                                             PreviewMouseLeftButtonUp="WindowList_PreviewMouseLeftButtonUp"
                                             PreviewKeyDown="WindowList_PreviewKeyDown"
                                             KeyboardNavigation.DirectionalNavigation="Contained">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" Width="18" Height="18">
                                                        <TextBlock Text="&#xE8B9;"
                                                                   FontFamily="{StaticResource FontIcon}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource BrushTextDim}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding Icon}"
                                                               Width="18"
                                                               Height="18"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Grid>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               Margin="10,0,12,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ProcessName}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource BrushTextDim}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="No windows found"
                                               FontSize="11.5"
                                               Foreground="{StaticResource BrushTextDim}"
                                               HorizontalAlignment="Center"
                                               Margin="0,16,0,16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=WindowList}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Popup>

                <Button Margin="0,12,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Start Picture-in-Picture"
                        Command="{Binding StartCommand}"
                        ToolTip="Select the mirror area next">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B9;"
                                   FontFamily="{StaticResource FontIcon}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0" />
                        <TextBlock Text="Start Picture-in-Picture" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid Margin="2,13,2,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                        <TextBlock Text="Live preview"
                                   FontSize="10.5"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Stays on top"
                               HorizontalAlignment="Right"
                               FontSize="10.5"
                               Foreground="{StaticResource BrushTextDim}"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
