<Window x:Class="FloatView.Views.PipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FloatView — Picture-in-Picture"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Background="{StaticResource BrushWindow}"
        MinWidth="160"
        MinHeight="140"
        Topmost="True"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource FontUi}"
        Foreground="{StaticResource BrushText}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="7"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root"
          Background="#0A0A10"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseEnter="Root_MouseEnter"
          MouseLeave="Root_MouseLeave">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hover toolbar -->
        <Border x:Name="Toolbar"
                Grid.Row="0"
                Height="34"
                Background="{StaticResource BrushToolbarGlass}"
                Visibility="Collapsed"
                Opacity="0">
            <DockPanel LastChildFill="True" Margin="6,0,6,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Width="26"
                            Height="26"
                            AutomationProperties.Name="Change window"
                            ToolTip="Mirror a different window"
                            Click="ChangeWindow_Click">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcon}" FontSize="11" />
                    </Button>
                    <ToggleButton x:Name="LockToggle"
                                  Style="{StaticResource ToolbarToggleStyle}"
                                  IsChecked="True"
                                  Margin="3,0,0,0"
                                  AutomationProperties.Name="Toggle aspect ratio lock"
                                  ToolTip="Keep the original aspect ratio"
                                  Checked="LockToggle_Changed"
                                  Unchecked="LockToggle_Changed">
                        <TextBlock x:Name="LockGlyph"
                                   Text="&#xE72E;"
                                   FontFamily="{StaticResource FontIcon}"
                                   FontSize="11" />
                    </ToggleButton>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Width="26"
                            Height="26"
                            Tag="Danger"
                            Margin="3,0,0,0"
                            AutomationProperties.Name="Close Picture-in-Picture"
                            ToolTip="Close Picture-in-Picture"
                            Click="Close_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource FontIcon}" FontSize="11" />
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TitleText"
                           VerticalAlignment="Center"
                           Margin="2,0,10,0"
                           FontSize="11"
                           Foreground="{StaticResource BrushTextMuted}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Live thumbnail area (painted by DWM) -->
        <Grid Grid.Row="1" Background="#0A0A10">
            <Path Data="M0,12 L12,0 M4,12 L12,4 M8,12 L12,8"
                  Stroke="#59FFFFFF"
                  StrokeThickness="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,5,5"
                  IsHitTestVisible="False" />
        </Grid>

        <!-- Refined window edge -->
        <Border Grid.RowSpan="2"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False" />
    </Grid>
</Window>
