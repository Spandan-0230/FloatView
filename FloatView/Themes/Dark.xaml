<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="ColorWindow">#121218</Color>
    <Color x:Key="ColorSurface">#1A1A23</Color>
    <Color x:Key="ColorSurfaceHover">#22222E</Color>
    <Color x:Key="ColorSurfaceActive">#2A2A38</Color>
    <Color x:Key="ColorBorder">#2C2C3A</Color>
    <Color x:Key="ColorBorderStrong">#3B3B4D</Color>
    <Color x:Key="ColorText">#F2F3F7</Color>
    <Color x:Key="ColorTextMuted">#9A9AAB</Color>
    <Color x:Key="ColorTextDim">#6C6C7C</Color>
    <Color x:Key="ColorAccent">#4F8CFF</Color>
    <Color x:Key="ColorAccentHover">#6BA1FF</Color>
    <Color x:Key="ColorAccentPressed">#3B74E8</Color>
    <Color x:Key="ColorDanger">#E5484D</Color>
    <Color x:Key="ColorSelectionTint">#2E4F8CFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushWindow" Color="{StaticResource ColorWindow}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="BrushSurfaceActive" Color="{StaticResource ColorSurfaceActive}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextDim" Color="{StaticResource ColorTextDim}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushAccentPressed" Color="{StaticResource ColorAccentPressed}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushSelectionTint" Color="{StaticResource ColorSelectionTint}" />
    <SolidColorBrush x:Key="BrushOverlayDim" Color="#8C04040A" />
    <SolidColorBrush x:Key="BrushToolbarGlass" Color="#F014141C" />
    <SolidColorBrush x:Key="BrushSuccess" Color="#3FCF8E" />
    <SolidColorBrush x:Key="BrushHairline" Color="#14FFFFFF" />

    <LinearGradientBrush x:Key="BrushWindowGradient" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#181820" Offset="0" />
        <GradientStop Color="#111116" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#619BFF" Offset="0" />
        <GradientStop Color="#3E7BF0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushSurfaceGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1D1D27" Offset="0" />
        <GradientStop Color="#181820" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontIcon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Common values -->
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Drop shadow used by floating surfaces -->
    <DropShadowEffect x:Key="ShadowCard"
                      BlurRadius="26"
                      ShadowDepth="0"
                      Opacity="0.55"
                      Color="#000000" />

</ResourceDictionary>
